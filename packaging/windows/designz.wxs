<?xml version="1.0" encoding="utf-8"?>
<!--
  DesignZ MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build designz.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.pcraft` owned by DesignZ,
  and DesignZ offered under "Open with" for PSD/PSB and the image formats it reads (without
  taking over the user's default app for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="DesignZ"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="174805DE-20FB-5217-B0C4-393F30675D68"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="DesignZ page layout and publishing" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of DesignZ is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DesignzIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DesignzIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/danish0440/designz" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/danish0440/designz" />
    <Property Id="ARPHELPLINK" Value="https://github.com/danish0440/designz/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="DesignZ" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="DesignZ" Level="1">
      <ComponentGroupRef Id="DesignzFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DesignzFiles" Directory="INSTALLFOLDER">
      <Component Id="DesignzApp" Guid="16B816AE-B265-52A6-87AE-9BE6D3D57F58">
        <File Id="DesignzExe" Source="$(var.BinDir)\designz.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="DesignZ"
              Description="DesignZ page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DesignzIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\designz.exe" Value="[#DesignzExe]" Type="string" />
      </Component>

      <Component Id="DesignzCli">
        <File Id="DesignzCliExe" Source="$(var.BinDir)\designz-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
