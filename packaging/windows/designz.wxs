<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="DesignZ" Manufacturer="Learning Machines LLC" Version="$(var.Version)" UpgradeCode="174805DE-20FB-5217-B0C4-393F30675D68" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="DesignZ page layout and publishing" Manufacturer="Learning Machines LLC" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of DesignZ is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DesignzIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DesignzIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/danish0440/designz" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/danish0440/designz" />
    <Property Id="ARPHELPLINK" Value="https://github.com/danish0440/designz/issues" />

    <!-- Shared native setup UI, including install/uninstall completion. -->

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Upstream">
        <Directory Id="INSTALLFOLDER" Name="DesignZ" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="DesignZ" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="DesignzFiles" />
      <ComponentGroupRef Id="CraftInstallerSettings" />
    </Feature>
    <!-- Shared full UI; app installation policy remains below. -->
    <UIRef Id="CraftInstallerUI" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="DesignzFiles" Directory="INSTALLFOLDER">
      <Component Id="DesignzNotice">
        <File Id="DesignzNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="DesignzApp" Guid="16B816AE-B265-52A6-87AE-9BE6D3D57F58">
        <File Id="DesignzExe" Source="$(var.BinDir)\designz.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="DesignZ" Description="DesignZ page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="DesignzIcon.ico" IconIndex="0" />
        </File>

        <!-- .designz: DesignZ's own format; DesignZ is its default app. -->
        <ProgId Id="Designz.Document" Description="DesignZ Document" Icon="DesignzExe" IconIndex="0">
          <Extension Id="designz" ContentType="application/x-designz">
            <Verb Id="open" Command="Open" TargetFile="DesignzExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- IDML: offered under "Open with", never forced as the default. -->
        <ProgId Id="Designz.Idml" Description="IDML Document" Icon="DesignzExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Designz.Idml\shell\open\command" Value="&quot;[#DesignzExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.idml\OpenWithProgids" Name="Designz.Idml" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "designz"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\designz.exe" Name="FriendlyAppName" Value="DesignZ" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\designz.exe\shell\open\command" Value="&quot;[#DesignzExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\designz.exe\SupportedTypes" Name=".designz" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\designz.exe\SupportedTypes" Name=".idml" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\designz.exe" Value="[#DesignzExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\DesignZ" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="DesignzCli">
        <File Id="DesignzCliExe" Source="$(var.BinDir)\designz-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
